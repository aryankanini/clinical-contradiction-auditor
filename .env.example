CONTEXT7_API_KEY=your-context7-api-key
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/clinical_auditor
DATABASE_ECHO=false

# Module 4 - API
API_HOST=127.0.0.1
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173
API_ARTIFACT_DIR=data/processed/ingest-artifacts
API_EXPORT_DIR=data/processed/compliance-exports
API_AUTO_CREATE_TABLES=true
API_MAX_BATCH_RECORDS=5000

# Module 4 - audit engine selection: auto | stub | module_2
AUDIT_ENGINE=auto

# Module 4 - AI reasoning (module 3 / AWS Bedrock)
# AI_ENABLED=false lets the API run with no AWS credentials present.
AI_ENABLED=true
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
AI_TIMEOUT_SECONDS=60
